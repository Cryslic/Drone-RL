    pygame.draw.circle(screen, "blue", (X1, Y1), 10)
    pygame.draw.circle(screen, "blue", (X2, Y2), 10)
    pygame.draw.circle(screen, "red", (O1, O2), 10)

    pygame.draw.circle(
        screen,
        "green",
        (CENTER_X + goal.x, CENTER_Y - goal.y),
        goal.radius,
        20,
    )


