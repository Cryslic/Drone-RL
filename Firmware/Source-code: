class World_Enviorment(gym.Env):
    def init(self):
        self.observation_space = gym.spaces.Dict(
            {
                "agent": gym.spaces.Box(
                    Drone.ox,
                    Drone.oy,
                    dtype=int,
                ),
                "target": gym.spaces.Box(
                    Goal.x,
                    Goal.y,
                    dtype=int,
                ),
            }
        )

        self.action_space = spaces.MultiDiscrete([16, 16])

        low = np.array(
            [-np.inf, -np.inf, -np.inf, -np.inf, -np.inf, -np.inf],
            dtype=np.float32,
        )

        high = np.array(
            [np.inf, np.inf, np.inf, np.inf, np.inf, np.inf],
            dtype=np.float32,
        )

        # Change the shape to (6,)
        self.observation_space = spaces.Box(
            low=low,
            high=high,
            shape=(6,),
            dtype=np.float32,
        )

    def _get_obs(self):
        return np.array(
            [
                Drone.vx,
                Drone.vy,
                Drone.px,
                Drone.py,
                Drone.ax,
                Drone.ay,
            ],
            dtype=np.float32,
        )


